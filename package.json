{
  "name": "lighting-survey",
  "version": "1.0.0",
  "private": true,
  "description": "PWA khảo sát hệ thống chiếu sáng công cộng",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "serve": "live-server --port=5500 --no-browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@vitest/coverage-v8": "^1.4.0",
    "jsdom": "^24.0.0",
    "live-server": "^1.2.2",
    "vitest": "^1.4.0"
  }
}
